<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of Kataware.
  @IDENTITY_NAME@, @PUBLISHER@, @PUBLISHER_DISPLAY_NAME@ and @VERSION@ are filled in
  by packaging/build_msix.ps1 (the Store values come from Partner Center).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Kataware</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Kataware" Executable="Kataware\Kataware.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Kataware"
        Description="Bluetooth 機器のバッテリー残量を表示します。分割キーボードは左右の残量を同時に表示します。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Launch at login (toggled from the tray menu; off until the user turns it on) -->
        <uap5:Extension Category="windows.startupTask" Executable="Kataware\Kataware.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="KatawareStartup" Enabled="false" DisplayName="Kataware" />
        </uap5:Extension>
        <!-- `kataware.exe` on PATH: lets the packaged app be started with arguments (CI self-test) -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Kataware\Kataware.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="kataware.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
